# Copy to .env.local and fill in. Never commit real values.

# Canonical site URL: http://localhost:3000 locally, https://froches.tech in production.
NEXT_PUBLIC_SITE_URL=

# Supabase. Locally, `npm run db:start` prints both (API URL and publishable key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bearer token for /api/cron/keepalive, at least 32 characters:
# openssl rand -hex 32
CRON_SECRET=
